library(funModeling)
debug(fixip)
debug(fixip)
fixip <- function(ip){
for(ip in ip){
ip1 <- round(ip, digits = 0)
ip2 <- round(ip - ip1, digits = 1)
if(ip2 == 0.2){
ip <- round(ip, digits = 0) + (2/3)
} else if(ip2 == 0.1){
ip <- round(ip, digits = 0) + (1/3)
} else {
ip <- ip
}
return(ip)
}
}
